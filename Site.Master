<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CRUD_ASP.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CRUD</title>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        body { background-color: #f4f6f9; }
        .card { border: 0; border-radius: .75rem; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
        .card-header { background: #fff; border-bottom: 1px solid #eef0f3; border-radius: .75rem .75rem 0 0 !important; }
        .table > :not(caption) > * > * { padding: .85rem .75rem; vertical-align: middle; }
        .btn-icon { width: 36px; height: 36px; padding: 0; display: inline-flex; align-items: center; justify-content: center; }
        .msg-error:empty { display: none; }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- NavBar -->
        <nav class="navbar navbar-expand-lg bg-dark shadow-sm" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" href="~/Pages/Index.aspx" runat="server">
                    <i class="bi bi-database-fill-gear me-2"></i>CRUD
                </a>
                <ul class="navbar-nav ms-auto flex-row gap-3">
                    <li class="nav-item">
                        <a class="nav-link" href="~/Pages/Index.aspx" runat="server">
                            <i class="bi bi-people me-1"></i>Usuarios
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/Pages/Crud.aspx" runat="server">
                            <i class="bi bi-person-plus me-1"></i>Nuevo
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Aquí se inyecta el contenido de cada página -->
        <div class="container my-4">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

    </form>

    <!-- Bootstrap 5.3 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>